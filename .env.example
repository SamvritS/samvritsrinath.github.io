# EmailJS Configuration (server-side)
# Used by the /api/contact route. Set these in your Vercel project dashboard
# (Settings → Environment Variables). Do NOT prefix with VITE_ — these are
# read by the Next.js server route, not the browser.

EMAILJS_SERVICE_ID="YOUR_SERVICE_ID"
EMAILJS_TEMPLATE_ID="YOUR_TEMPLATE_ID"
EMAILJS_PUBLIC_KEY="YOUR_PUBLIC_KEY"
EMAILJS_PRIVATE_KEY="YOUR_PRIVATE_KEY"

# Canonical, sitemap, robots, and Open Graph base URL.
NEXT_PUBLIC_SITE_URL="https://samvrit.vercel.app"
